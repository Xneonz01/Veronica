# Veronica environment overrides. Copy to .env in this folder (.env is git-ignored) and
# uncomment what you need; as shipped, every line is commented out and the defaults apply.
#
# Settings are read by backend/app/core/config.py. Prefix every variable with
# VERONICA_ and use "__" to reach a nested section, e.g. VERONICA_GPU__VRAM_BUDGET_GB
# sets gpu.vram_budget_gb. Environment variables beat .env, which beats the YAML
# profile, which beats configs/default.yaml.

# Selects configs/profile.<name>.yaml.
# VERONICA_PROFILE=gpu_16gb

# Where all of her data is kept (memory, voices, documents, diagnostics). Relative to
# the installation, or absolute; the folder is made private to the account she runs as.
# Moving it doesn't move what is already there: move the folder's contents yourself.
# VERONICA_DATA_DIR=D:/veronica-data

# Examples of nested overrides:
# VERONICA_LLM__MODEL=qwen3:14b
# VERONICA_LOGGING__LEVEL=DEBUG

# Local diagnostics (the black box and performance log, in the data folder's telemetry
# folder) are on by default and never leave the machine. To switch them off:
# VERONICA_TELEMETRY__ENABLED=false
